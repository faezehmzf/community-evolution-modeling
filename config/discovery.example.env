# TDMEC data-discovery configuration TEMPLATE.
#
# Copy to `config/discovery.local.env` (git-ignored) and fill in real values,
# or export these variables directly in the Cloud Agent environment.
#
# NEVER commit real Google Drive folder IDs, URLs, tokens, or credentials.

# ---------------------------------------------------------------------------
# Dataset sources.
#
# Each *_SOURCE accepts ANY of the following forms so the same code runs on a
# local machine, Colab, Kaggle, Lightning AI, or a persistent Linux host:
#
#   local:/absolute/path/to/folder          -> ordinary filesystem directory
#   gdrive-anon:<folder_id or share URL>    -> public "anyone with link" Drive folder (gdown, read-only)
#   gdrive-api:<folder_id>                  -> Drive folder read via authenticated API (needs credentials)
#
# A bare filesystem path or a bare Drive folder id / URL is also accepted and
# auto-detected.
# ---------------------------------------------------------------------------
DATASET_A_SOURCE=gdrive-anon:<dataset_a_folder_id>
DATASET_B_SOURCE=gdrive-anon:<dataset_b_folder_id>

# Optional: explicit folder ids (used by the authenticated Drive API adapter).
DATASET_A_DRIVE_FOLDER_ID=
DATASET_B_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Output locations.
# ---------------------------------------------------------------------------
# Local root where discovery outputs are written before publication.
DISCOVERY_OUTPUT_ROOT=./artifacts/discovery
# Local root for cached downloads of source files (temporary, never committed).
DISCOVERY_CACHE_ROOT=/tmp/tdmec_cache

# Google Drive output folder id (the ONLY Drive location writes are allowed).
TDMEC_OUTPUT_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Credentials (authenticated Drive API only; leave blank for anonymous reads).
# Point this at a service-account JSON key file mounted by the environment.
# NEVER commit the key file itself.
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
