# TDMEC data-discovery configuration TEMPLATE.
#
# Copy to `config/discovery.local.env` (git-ignored) and fill in real values,
# or export these variables directly in the Lightning AI Studio environment.
#
# NEVER commit real Google Drive folder IDs, URLs, tokens, or credentials.

# ---------------------------------------------------------------------------
# Dataset sources.
#
# Each *_SOURCE accepts ANY of the following forms so the same code runs on a
# local machine, Lightning AI Studio, or (optionally) Google Drive:
#
#   local:/absolute/path/to/folder          -> ordinary filesystem directory
#   gdrive-anon:<folder_id or share URL>    -> public Drive folder (optional)
#   gdrive-api:<folder_id>                  -> authenticated Drive API (optional)
#
# A bare filesystem path is also accepted and auto-detected as local.
# Lightning AI Studio defaults below assume data was imported into the Studio.
# ---------------------------------------------------------------------------
DATASET_A_SOURCE=local:/teamspace/studios/this_studio/Dataset A/core_army_pro_fans_tweets
DATASET_B_SOURCE=local:/teamspace/studios/this_studio/Dataset B/statuses_data

# Optional: explicit folder ids (used only by the authenticated Drive API adapter).
DATASET_A_DRIVE_FOLDER_ID=
DATASET_B_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Output locations.
# ---------------------------------------------------------------------------
# Local root where discovery outputs are written.
DISCOVERY_OUTPUT_ROOT=/teamspace/studios/this_studio/TDMEC_PROJECT_OUTPUTS
# Local root for cached downloads of source files (temporary, never committed).
DISCOVERY_CACHE_ROOT=/tmp/tdmec_cache

# Optional Google Drive output folder id (leave blank for local-only Studio runs).
TDMEC_OUTPUT_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Credentials (authenticated Drive API only; leave blank for local Studio runs).
# Point this at a service-account JSON key file if Drive API is required.
# NEVER commit the key file itself.
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=
